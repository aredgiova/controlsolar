# Sólo proceso web de staging. Copiar fuera del repositorio y completar en privado.
# Valores vacíos o example.invalid no pasan preflight. No son conexiones activas.
APP_ENV=staging
DATA_ADAPTER=postgres
DEMO_MODE=false
APP_BASE_URL=https://solar-staging.example.invalid
DATABASE_URL=
AUTH_DATABASE_URL=
AUTH_SECRET=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
REPORT_STORAGE=s3
REPORT_S3_BUCKET=
AWS_REGION=
REPORT_S3_ACCOUNT_ID=
# DATABASE_URL: solar_runtime; AUTH_DATABASE_URL: solar_auth; misma base solar_staging.
# Ambas URLs requieren ?sslmode=verify-full; agregar sslrootcert si el proveedor lo exige.
# Cognito: completar desde outputs del stack; secreto del cliente opcional, AUTH_SECRET siempre privado.
# S3: identidad AWS sólo GetObject sobre reports/*, separada del worker. Preferir credenciales temporales.
# No incluir WORKER_DATABASE_URL, INGEST_DATABASE_URL, DATABASE_MIGRATION_URL ni BACKUP_*.
