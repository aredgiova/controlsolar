# Non-secret values for the dedicated ControlSolar demo project in Vercel.
# Configure all three in Preview and Production, then redeploy.
# Vercel's Production scope is independent of the application's APP_ENV.
APP_ENV=staging
DATA_ADAPTER=demo
DEMO_MODE=true

# This demo needs no database, Cognito, AWS credentials or APP_BASE_URL.
# Do not set NODE_ENV; Next.js/Vercel manage it.
