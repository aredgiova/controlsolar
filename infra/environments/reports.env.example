# Worker independiente de PDF. Usar el mismo bucket/propietario/región que el web del entorno.
APP_ENV=staging
DATA_ADAPTER=postgres
DEMO_MODE=false
WORKER_DATABASE_URL=
REPORT_STORAGE=s3
REPORT_S3_BUCKET=
AWS_REGION=
REPORT_S3_ACCOUNT_ID=
# solar_worker con verify-full; identidad AWS separada con GetObject+PutObject sobre reports/*.
# No incluir DATABASE_URL, AUTH_DATABASE_URL, AUTH_SECRET, INGEST_DATABASE_URL ni BACKUP_*.
