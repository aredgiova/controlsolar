# Copiar a .env.local para el recorrido local. Solo datos ficticios.
APP_ENV=development
DATA_ADAPTER=demo
DEMO_MODE=true
# Para staging, usar APP_ENV=staging y un destino separado de clientes.
# No activar demo en APP_ENV=production.
# Para gestión, cambiar DATA_ADAPTER=postgres y DEMO_MODE=false.
# Los siguientes son ejemplos, nunca credenciales válidas.
# DATABASE_URL=postgresql://solar_runtime:example_password@db.example.invalid:5432/solar_staging?sslmode=verify-full
# AUTH_DATABASE_URL=postgresql://solar_auth:other_example_password@db.example.invalid:5432/solar_staging?sslmode=verify-full
# APP_BASE_URL=https://solar-staging.example.invalid
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_Example
# COGNITO_CLIENT_ID=example-client-id
# COGNITO_CLIENT_SECRET=solo-si-el-cliente-tiene-secreto
# COGNITO_DOMAIN=https://example.auth.us-east-1.amazoncognito.com
# AUTH_SECRET=generar-un-secreto-aleatorio-privado-de-al-menos-32-bytes
# DATABASE_MIGRATION_URL solo en el proceso CLI de migración, nunca en el servidor web.
# INGEST_DATABASE_URL=postgresql://solar_ingest:ingest_example_password@db.example.invalid:5432/solar_staging?sslmode=verify-full
# INGEST_DATABASE_URL solo para simulador/ingesta. No se necesita en el servidor web.
# Para preparar acceso real, usar infra/environments/staging.env.example.
# Monitor, informes y Lambda tienen archivos de entorno separados en ese directorio.
# No juntar credenciales web, worker, ingesta, migración o respaldo en .env.local.
# Ver docs/connection-readiness.md y ejecutar npm run preflight antes del despliegue.
