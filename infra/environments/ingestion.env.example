# Configuración pública para revisar Lambda; sus outputs y AWS_REGION los suministra AWS.
# APP_ENV etiqueta el diagnóstico; Lambda siempre exige solar_ingest con verify-full.
APP_ENV=staging
AWS_REGION=
INGEST_DATABASE_SECRET_ARN=
INGEST_QUEUE_ARN=
# El secreto AWS contiene {"INGEST_DATABASE_URL":"postgresql://solar_ingest:...?..."}.
# No pegar ese valor aquí ni entregar credenciales SQL al gateway.
# No incluir claves AWS: Lambda recibe su rol restringido de infra/ingestion.json.
