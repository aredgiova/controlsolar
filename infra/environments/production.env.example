# Sólo proceso web de producción. Recursos y secretos diferentes de staging.
# Copiar fuera del repositorio; los valores vacíos/example.invalid no pasan preflight.
APP_ENV=production
DATA_ADAPTER=postgres
DEMO_MODE=false
APP_BASE_URL=https://solar.example.invalid
DATABASE_URL=
AUTH_DATABASE_URL=
AUTH_SECRET=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
REPORT_STORAGE=s3
REPORT_S3_BUCKET=
AWS_REGION=
REPORT_S3_ACCOUNT_ID=
# DATABASE_URL: solar_runtime; AUTH_DATABASE_URL: solar_auth; misma base solar_production, verify-full.
# Cognito: outputs del pool de producción. S3: bucket/cuenta/región exclusivos del entorno.
# Identidad AWS web con GetObject sobre reports/*; worker diferente con GetObject+PutObject.
# No incluir WORKER_DATABASE_URL, INGEST_DATABASE_URL, DATABASE_MIGRATION_URL ni BACKUP_*.
