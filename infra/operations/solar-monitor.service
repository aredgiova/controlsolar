[Unit]
Description=Monitoreo Solar - alert evaluation and in-app notifications
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=solar-monitor
Group=solar-monitor
WorkingDirectory=/opt/solar/workers
Environment=NODE_ENV=production
EnvironmentFile=/etc/solar/monitor.env
ExecStartPre=/usr/bin/node --eval "if (process.versions.node.split('.')[0] !== '24') process.exit(1)"
ExecStart=/usr/bin/node /opt/solar/workers/monitor.mjs
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
